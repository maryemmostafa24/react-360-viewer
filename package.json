{
    "name": "@mmmmzxe/react-360-view",
    "version": "1.0.0",
    "description": "A standalone, configurable 360° image viewer for React with drag rotation, zoom, hotspots, and auto-rotate support.",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./styles.css": "./dist/styles.css"
    },
    "sideEffects": [
        "./dist/styles.css"
    ],
    "files": [
        "dist/index.js",
        "dist/index.d.ts",
        "dist/styles.css",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup && npm run build:css && node scripts/scope-styles.mjs",
        "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
        "dev": "tsup --watch",
        "tsc": "tsc --noEmit",
        "test": "vitest",
        "test-run": "vitest run",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18",
        "lucide-react": ">=0.400.0"
    },
    "devDependencies": {
        "@radix-ui/react-separator": "^1.1.7",
        "@radix-ui/react-slot": "^1.2.3",
        "@tailwindcss/cli": "^4.1.11",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.0",
        "@types/react": "19.2.2",
        "@types/react-dom": "19.2.2",
        "@vitejs/plugin-react": "^5.0.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "jsdom": "^27.0.1",
        "lucide-react": "^0.561.0",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "tailwind-merge": "^3.4.0",
        "tailwindcss": "^4.1.11",
        "tsup": "^8.5.0",
        "typescript": "^5",
        "vitest": "^3.2.4"
    },
    "keywords": [
        "react",
        "360",
        "viewer",
        "panorama",
        "product-viewer",
        "hotspot",
        "typescript",
        "tailwindcss",
        "shadcn"
    ],
    "homepage": "https://github.com/maryemmostafa24/react-360-viewer#readme",
    "bugs": {
        "url": "https://github.com/maryemmostafa24/react-360-viewer/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/maryemmostafa24/react-360-viewer.git"
    },
    "publishConfig": {
        "access": "public"
    }
}
